{
  "name": "Curier",
  "version": "0.1.0",
  "description": "Async Web Push sender for ESP32 with VAPID and RFC 8291 aes128gcm encryption.",
  "keywords": [
    "esp32",
    "web-push",
    "push-notification",
    "vapid",
    "aes128gcm",
    "curier"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ZekStack/curier.git"
  },
  "authors": [
    {
      "name": "zekageri",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "dependencies": {
    "bblanchon/ArduinoJson": ">=7.0.0"
  },
  "build": {
    "srcDir": "src",
    "includeDir": "src",
    "flags": [
      "-std=gnu++20"
    ]
  }
}
